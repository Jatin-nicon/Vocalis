# Voice-PC-Assistant Environment Settings
# Copy this file to `.env` and fill in the keys you need.
# `.env` is git-ignored -- never commit real keys.

# (Optional) Cloud LLM key for conversational answers and smart fallback:
GROQ_API_KEY=

# (Optional) OpenRouter fallback key (used when Groq is unavailable):
OPENROUTER_API_KEY=

# Global Hotkey Override (default: ctrl+space)
HOTKEY=ctrl+space

# Whisper Model Size (tiny, base, small) - default: base
WHISPER_MODEL=base
