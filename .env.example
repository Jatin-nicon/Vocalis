# Vocalis / Jarvis - Environment Settings
#
# Copy this file to `.env` and fill in only what you need:
#     copy .env.example .env
#
# `.env` is git-ignored -- never commit real keys.
#
# IMPORTANT: every value set here OVERRIDES config/default_settings.json.
# Leave a setting unset (or commented out) to keep the default.
#
# ---------------------------------------------------------------------------
# Do you need any of these? NO.
# ---------------------------------------------------------------------------
# Every voice command, every dictation action and every offline question
# (time, date, battery, CPU/RAM, jokes, weather) works with NO API key.
# The keys below are only needed for free-form conversation.
# Both providers below have free tiers that need no credit card:
#
#     Groq       ->  https://console.groq.com/keys
#     OpenRouter ->  https://openrouter.ai/keys
#
# Add ONE of them to unlock conversational answers.

# (Optional) Cloud LLM key for conversational answers and smart fallback:
GROQ_API_KEY=

# (Optional) OpenRouter fallback key (used when Groq is unavailable):
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Optional overrides - uncomment only if you want to change the default
# ---------------------------------------------------------------------------

# Global hotkey (default: ctrl+space)
# HOTKEY=ctrl+space

# Whisper model size: tiny | base | small  (default: small.en)
# WHISPER_MODEL=small.en
